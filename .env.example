# Copy to .env.local (gitignored) and fill in from the Supabase project's
# Settings > API page. Both are safe to expose client-side (the anon key is
# meant to be public; row-level security governs actual access).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# From the PostHog project's Settings > Project API Key (EU Cloud). Also safe to
# expose client-side — it's a write-only ingestion key, not a secret.
VITE_POSTHOG_KEY=

# Server-side only (used by api/analytics-report.ts) — never prefix these with VITE_,
# which would bundle them into client-side code.
#
# Personal API key from PostHog Settings > Personal API Keys (needs read access to
# the MapsyQuest project), and that project's numeric ID from Project Settings.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
# From @BotFather, and the chat/channel id the report should be posted to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret required to trigger GET /api/analytics-report — generate a random
# string and send it as `Authorization: Bearer <value>`.
ANALYTICS_REPORT_SECRET=
