# Copy to .env.local (gitignored) and fill in from the Supabase project's
# Settings > API page. Both are safe to expose client-side (the anon key is
# meant to be public; row-level security governs actual access).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# From the PostHog project's Settings > Project API Key (EU Cloud). Also safe to
# expose client-side — it's a write-only ingestion key, not a secret.
VITE_POSTHOG_KEY=
